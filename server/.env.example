# Copy to .env for local development. In production (Azure App Service),
# these are set as Application Settings instead of a committed file.

NODE_ENV=development
PORT=3001

# Local dev default matches docker-compose.yml. In Azure this points at
# Azure Database for PostgreSQL Flexible Server (see infra/).
DATABASE_URL=postgres://powerprep:powerprep_dev_password@localhost:5432/powerprep

# Set to "disable" only for local Postgres without SSL. Leave unset in
# production so the app requires SSL against Azure Postgres.
PGSSLMODE=disable
